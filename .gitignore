# Environment variables and secrets (never commit)
.env
.env.local
.env.*.local

# Database files
*.db
*.db-journal
# ...and the timestamped copies the migrations leave beside it.
*.db.*.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
*.log.*

# TMDB images downloaded by step 14. Regenerable from the database, and
# TMDB's to license rather than ours to redistribute.
static/tmdb/

# Data (raw exports, working files, not committed)
data/raw/
data/staging/
data/*.csv
data/*.xlsx.bak

# ...except the source of truth. episodes.csv is the episode list itself, and
# the reason it is a CSV rather than the xlsx it replaced is so that git can
# show which episode changed. It has to be tracked for that to mean anything.
!data/episodes.csv

# The same goes for the upcoming-films list, converted from
# "remaining films.xlsx" by convert_xlsx_to_csv.py --source upcoming. It is a
# source of truth in exactly the same sense: a hand-curated list whose changes
# need to be reviewable as a diff.
!data/upcoming.csv

# ...and the manual-review decisions. Step 08 replays them after every rebuild,
# so this file is the only record of a hand-corrected match ('Crash', 2004).
# Tracked so it is backed up with the repo and changes show as a diff.
!data/manual_review.csv

# OS
.DS_Store
Thumbs.db

# Temporary
# Excel's owner file beside a workbook it has open (~$episodes.xlsx).
~$*
*.tmp
tmp/
temp/

# The public site (site/). Its data under site/src/data/ is written by pipeline
# step 15 and IS tracked: CI builds from it. Only the build's own byproducts
# are ignored.
site/node_modules/
site/dist/
site/src/.observablehq/cache/
