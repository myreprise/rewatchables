# Copy to config/.env and fill in. config/.env is gitignored; this template is
# not, so never put a real key here.
#
# Only the pipeline scripts read this file. The app does not: it always reads
# ./rewatchables.db, whatever DB_PATH says.

# Required by the steps that reach TMDB: 04, 08, 09, 10 and 13.
# Free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Optional; the defaults are shown ─────────────────────────────────────────

# Wikimedia asks API clients for a descriptive User-Agent (steps 10 and 12).
# WIKIMEDIA_USER_AGENT=rewatchables-pipeline/0.1 (https://github.com/myreprise/rewatchables)

# The database the pipeline writes.
# DB_PATH=rewatchables.db

# LOG_LEVEL=INFO

# Step 04's rule for accepting a TMDB match without review.
# MATCH_CONFIDENCE_THRESHOLD=0.85
# MATCH_YEAR_WINDOW=2

# Source files. Step 01 reads SOURCE_XLSX and writes SOURCE_CSV; step 02 reads
# SOURCE_CSV. Step 13 reads UPCOMING_XLSX and writes UPCOMING_CSV.
# SOURCE_XLSX=data/episodes.xlsx
# SOURCE_CSV=data/episodes.csv
# UPCOMING_XLSX=data/remaining films.xlsx
# UPCOMING_CSV=data/upcoming.csv
